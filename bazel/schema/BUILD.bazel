load("//bazel/rules:schema_bundle.bzl", "schema_bundle")

schema_bundle(
    name = "public-schema-bundle",
    testonly = True,
    generator = "//codex-rs/app-server-protocol:schema-generator-on-demand",
    tags = ["manual"],
)

schema_bundle(
    name = "app-server",
    generator = "//codex-rs/app-server-protocol:schema-generator-on-demand",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "stable",
    srcs = [":app-server"],
    output_group = "stable",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
