load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "linux-sandbox",
    crate_name = "codex_linux_sandbox",
    extra_binaries = [
        "//codex-rs/bwrap:bwrap",
    ],
    rustc_env_files = select({
        "@platforms//os:linux": ["//codex-rs/bwrap:bwrap-sha256-env"],
        "//conditions:default": [],
    }),
    test_data_extra = [":managed-tcp-test-data"],
)

config_setting(
    name = "linux-x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "managed-tcp-test-data",
    testonly = True,
    srcs = select({
        ":linux-x86_64": ["@managed_tcp_test_bubblewrap_noble_amd64//:usr/bin/bwrap"],
        "//conditions:default": [],
    }),
)
