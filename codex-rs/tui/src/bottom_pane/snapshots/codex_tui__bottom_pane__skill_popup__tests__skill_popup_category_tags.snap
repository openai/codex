---
source: tui/src/bottom_pane/skill_popup.rs
expression: "snapshots.join(\"\\n\\n\")"
---
name="Shared", width=32
Buffer {
    area: Rect { x: 0, y: 0, width: 32, height: 5 },
    content: [
        "                                ",
        "› Shared  [App]                 ",
        "  Shared  [Skill]               ",
        "                                ",
        "  enter insert · esc close      ",
    ],
    styles: [
        x: 0, y: 0, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,
        x: 0, y: 1, fg: Reset, bg: Reset, underline: Reset, modifier: BOLD | REVERSED,
        x: 10, y: 1, fg: Reset, bg: Reset, underline: Reset, modifier: REVERSED,
        x: 15, y: 1, fg: Reset, bg: Reset, underline: Reset, modifier: BOLD | REVERSED,
        x: 0, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,
        x: 2, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: BOLD,
        x: 8, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,
        x: 10, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,
        x: 17, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,
        x: 2, y: 4, fg: Reset, bg: Reset, underline: Reset, modifier: BOLD,
        x: 7, y: 4, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,
        x: 17, y: 4, fg: Reset, bg: Reset, underline: Reset, modifier: BOLD,
        x: 20, y: 4, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,
        x: 26, y: 4, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,
    ]
}

