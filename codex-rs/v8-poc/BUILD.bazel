load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "v8-poc",
    crate_features = ["sandbox"],
    crate_name = "codex_v8_poc",
    deps_extra = ["@crates//:v8"],
    # The ignored CppGC ABI checks require the native archive/binding pair.
    unit_test_args = select({
        "//third_party/v8:use_rusty_v8_prebuilts": [],
        "//conditions:default": ["--include-ignored"],
    }),
)

alias(
    name = "v8-poc-rusty-v8",
    actual = ":v8-poc",
)
