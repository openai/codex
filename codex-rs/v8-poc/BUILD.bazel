load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "v8-poc",
    crate_features = ["sandbox"],
    crate_name = "codex_v8_poc",
    deps_extra = ["@crates//:v8"],
    # Bazel always builds the native pair required by the CppGC ABI checks.
    unit_test_args = ["--include-ignored"],
)

alias(
    name = "v8-poc-rusty-v8",
    actual = ":v8-poc",
)
