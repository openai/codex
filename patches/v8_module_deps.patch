diff --git a/orig/v8-15.2.124.1/bazel/codex_deps.bzl b/mod/v8-15.2.124.1/bazel/codex_deps.bzl
new file mode 100644
--- /dev/null
+++ b/mod/v8-15.2.124.1/bazel/codex_deps.bzl
@@ -0,0 +1,10 @@
+"""Dependency ingress for V8 when built by Codex.
+
+The root module injects the repositories; this extension declares no defaults
+that could silently select a different dependency from the one Codex builds.
+"""
+
+def _codex_deps_impl(module_ctx):
+    return module_ctx.extension_metadata(reproducible = True)
+
+codex_deps = module_extension(implementation = _codex_deps_impl)
