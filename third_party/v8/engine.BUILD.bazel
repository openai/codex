    srcs = select({
        "@@//third_party/v8:platform_windows_msvc": ["src/heap/base/asm/x64/push_registers_masm.asm"],
        "//conditions:default": ["@@//third_party/v8:push_registers_gnullvm.S"],
    }),
)

alias(
