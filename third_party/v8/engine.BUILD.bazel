# Used by the Codex-owned pip hub; pin changes travel with the V8 source.
exports_files(["bazel/requirements.txt"])

# Codex V8 source policy. Only ABI, runtime and target CPU vary, selected by
# artifact profiles. CPU selection lives in bazel/config.
# Platform feature choices preserve the published Bazel Unix and GN MSVC builds.
# ICU and no-ICU remain separate targets for the engine and its generators.
v8_flag(name = "v8_enable_sandbox")

v8_flag(name = "v8_use_rusty_v8_custom_libcxx")

# Maglev is supported on the two architectures shipped by Codex. Keep the
# architecture tests separate from feature policy for host-tool transitions.
selects.config_setting_group(
    name = "enable_maglev",
    match_any = [
        "@v8//bazel/config:v8_target_x64",
        "@v8//bazel/config:v8_target_arm64",
    ],
)

selects.config_setting_group(
    name = "enable_maglev_x64",
    match_all = [
        ":enable_maglev",
        "@v8//bazel/config:v8_target_x64",
    ],
)

selects.config_setting_group(
    name = "enable_maglev_arm64",
    match_all = [
        ":enable_maglev",
        "@v8//bazel/config:v8_target_arm64",
    ],
)

# WebAssembly remains enabled; its source implementation still depends on OS.
selects.config_setting_group(
    name = "webassembly_on_posix",
    match_any = ["@v8//bazel/config:is_posix"],
)

selects.config_setting_group(
    name = "webassembly_on_windows",
    match_any = ["@v8//bazel/config:is_windows"],
)

# Artifact transitions set True or False, never the upstream "none" auto mode.
# The 32-bit Torque helper can also force this off.
v8_string(
    name = "v8_enable_pointer_compression",
    default = "False",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "is_v8_enable_pointer_compression",
    flag_values = {":v8_enable_pointer_compression": "True"},
)

# V8's pinned default short-call policy differs on x64 and arm64. In particular
# the legacy arm64 non-pointer-compressed profile still uses short calls.
selects.config_setting_group(
    name = "v8_target_x64_default_short_builtin_calls",
    match_all = [
        "@v8//bazel/config:v8_target_x64",
        ":is_v8_enable_pointer_compression",
    ],
)

selects.config_setting_group(
    name = "v8_target_arm64_default_short_builtin_calls",
    match_all = [
        "@v8//bazel/config:v8_target_arm64",
        "@v8//bazel/config:is_not_android",
    ],
)

selects.config_setting_group(
    name = "is_v8_enable_short_builtin_calls",
    match_any = [
        ":v8_target_x64_default_short_builtin_calls",
        ":v8_target_arm64_default_short_builtin_calls",
    ],
)

# Fixed V8 15.2 Codex feature contract: TurboFan and WebAssembly enabled;
# experiments, VTune and profiling disabled. Do not hard-code ABI-sensitive
# values such as sandbox, pointer compression or target CPU into this baseline.
v8_config(
    name = "define_flags",
    conditional_defines = {"v8_enable_sandbox": "V8_ENABLE_SANDBOX"},
    defines = [
        "V8_DEPRECATION_WARNINGS",
        "V8_ENABLE_LAZY_SOURCE_POSITIONS",
        "V8_ENABLE_TURBOFAN",
        "V8_ENABLE_WEBASSEMBLY",
        "V8_ENABLE_UNDEFINED_DOUBLE",
        "V8_USE_HOST_CPU_ARM_FEATURES",
    ] + [
        "GOOGLE3",
        "V8_ADVANCED_BIGINT_ALGORITHMS",
        "V8_CONCURRENT_MARKING",
        "V8_ENABLE_SPARKPLUG",
        "V8_ENABLE_EXTENSIBLE_RO_SNAPSHOT",
        "V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA",
        "V8_TLS_USED_IN_LIBRARY",
    ] + select({
        # The published MSVC artifacts used GN's CppGC queue and Wasm fuzzers.
        # Keep these choices in the owned policy, including snapshot generators.
        "@@//third_party/v8:platform_windows_msvc": [
            "V8_CPPGC_MICROTASK_QUEUE",
            "V8_WASM_RANDOM_FUZZERS",
            "V8_TYPED_ARRAY_MAX_SIZE_IN_HEAP=0",
        ],
        "//conditions:default": [
            "V8_IMMINENT_DEPRECATION_WARNINGS",
            "V8_TYPED_ARRAY_MAX_SIZE_IN_HEAP=64",
        ],
    }) + select({
        "@v8//bazel/config:is_debug": [
            "DEBUG",
            "V8_ENABLE_CHECKS",
        ],
        "//conditions:default": [],
    }) + select({
        "@v8//bazel/config:asan_enabled": ["V8_USE_ADDRESS_SANITIZER"],
        "//conditions:default": [],
    }) + select({
        "@v8//bazel/config:hwasan_enabled": ["V8_USE_HWADDRESS_SANITIZER"],
        "//conditions:default": [],
    }) + select({
        "@v8//bazel/config:msan_enabled": ["V8_USE_MEMORY_SANITIZER"],
        "//conditions:default": [],
    }) + select({
        "@v8//bazel/config:ubsan_enabled": ["V8_USE_UNDEFINED_BEHAVIOR_SANITIZER"],
        "//conditions:default": [],
    }) + select(
        {
            "@v8//bazel/config:v8_target_ia32": ["V8_TARGET_ARCH_IA32"],
            "@v8//bazel/config:v8_target_x64": [
                "V8_TARGET_ARCH_X64",
                "V8_ENABLE_SPARKPLUG_PLUS",
            ],
            "@v8//bazel/config:v8_target_arm": [
                "V8_TARGET_ARCH_ARM",
                "CAN_USE_ARMV7_INSTRUCTIONS",
                "CAN_USE_VFP3_INSTRUCTIONS",
            ],
            "@v8//bazel/config:v8_target_arm64": [
                "V8_TARGET_ARCH_ARM64",
                "V8_ENABLE_SPARKPLUG_PLUS",
            ],
            "@v8//bazel/config:v8_target_s390x": [
                "V8_TARGET_ARCH_S390X",
            ],
            "@v8//bazel/config:v8_target_riscv64": [
                # NOTE: Bazel rules for riscv64 weren't tested on a real system.
                "V8_TARGET_ARCH_RISCV64",
                "CAN_USE_FPU_INSTRUCTIONS",
            ],
            "@v8//bazel/config:v8_target_ppc64le": [
                # NOTE: Bazel rules for ppc64le weren't tested on a real system.
                "V8_TARGET_ARCH_PPC64",
            ],
        },
        no_match_error = "Please specify a target cpu supported by v8",
    ) + select({
        "@v8//bazel/config:is_android": [
            "V8_HAVE_TARGET_OS",
            "V8_TARGET_OS_ANDROID",
        ],
        "@v8//bazel/config:is_linux": [
            "V8_HAVE_TARGET_OS",
            "V8_TARGET_OS_LINUX",
        ],
        "@v8//bazel/config:is_macos": [
            "V8_HAVE_TARGET_OS",
            "V8_TARGET_OS_MACOS",
        ],
        "@v8//bazel/config:is_windows": [
            "V8_HAVE_TARGET_OS",
            "V8_TARGET_OS_WIN",
            "UNICODE",
            "_UNICODE",
            "_CRT_RAND_S",
            "_WIN32_WINNT=0x0A00",
        ],
    }) + select({
        ":is_v8_enable_pointer_compression": [
            "V8_COMPRESS_POINTERS",
            "V8_31BIT_SMIS_ON_64BIT_ARCH",
            "V8_CONTIGUOUS_COMPRESSED_RO_SPACE",
            "V8_CONTIGUOUS_COMPRESSED_RO_SPACE_SIZE_MB=8",
        ],
        "//conditions:default": [],
    }) + select({
        ":is_v8_enable_pointer_compression": [
            "V8_COMPRESS_POINTERS_IN_SHARED_CAGE",
        ],
        "//conditions:default": [],
    }) + select({
        ":is_v8_enable_short_builtin_calls": [
            "V8_SHORT_BUILTIN_CALLS",
        ],
        "//conditions:default": [],
    }) + select({
        ":is_v8_enable_pointer_compression": [
            "V8_EXTERNAL_CODE_SPACE",
        ],
        "//conditions:default": [],
    }) + select({
        ":is_v8_enable_pointer_compression": [
            "V8_STATIC_ROOTS",
        ],
        "//conditions:default": [],
    }) + select({
        ":enable_maglev": [
            "V8_ENABLE_MAGLEV",
        ],
        "//conditions:default": [],
    }) + [] + [],
    deps = [],
)

# Source inventory and dependency aliases.

# The imported groups retain upstream select names. They express our pinned
# feature contract here; only CPU, ABI and the C++ runtime actually vary.
v8_fixed_source_features(
    name = "pinned_source_features",
    build_setting_default = True,
)

config_setting(
    name = "is_v8_enable_webassembly",
    flag_values = {":pinned_source_features": "True"},
)

config_setting(
    name = "disabled_pinned_source_feature",
    flag_values = {":pinned_source_features": "False"},
)

alias(
    name = "enable_drumbrake_arm64",
    actual = ":disabled_pinned_source_feature",
)

alias(
    name = "enable_drumbrake_x64",
    actual = ":disabled_pinned_source_feature",
)

alias(
    name = "enable_maglev_arm",
    actual = ":disabled_pinned_source_feature",
)

alias(
    name = "enable_maglev_riscv",
    actual = ":disabled_pinned_source_feature",
)

alias(
    name = "is_v8_enable_drumbrake",
    actual = ":disabled_pinned_source_feature",
)

alias(
    name = "is_v8_enable_experimental_tq_to_tsa",
    actual = ":disabled_pinned_source_feature",
)

alias(
    name = "is_v8_wasm_random_fuzzers",
    actual = "@@//third_party/v8:platform_windows_msvc",
)

# @CODEX_V8_UPSTREAM_FILEGROUPS@

filegroup(
    name = "windows_x64_stack_assembly",
