load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    defines = ["LIBC_NAMESPACE=__llvm_libc_cr"],
    includes = ["."],
)

cc_library(
    name = "v8_headers",
    hdrs = glob(["shared/**/*.h"]),
    include_prefix = "third_party/llvm-libc/src",
    deps = [":headers"],
)
