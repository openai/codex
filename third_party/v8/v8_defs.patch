         progress_message = "Running mksnapshot",
     )
+    if ctx.attr.inline_asm_converter:
+        # The installed Windows toolchain sends .S files to MASM. V8 provides
+        # this conversion for clang-cl so its generated assembly is compiled
+        # as C++, using the same target flags as the rest of the engine.
+        embedded_cc = ctx.actions.declare_file(prefix + "/embedded" + suffix + ".cc")
+        ctx.actions.run(
+            executable = ctx.attr.inline_asm_converter[DefaultInfo].files_to_run,
+            inputs = [outs[1]],
+            outputs = [embedded_cc],
+            arguments = [outs[1].path, embedded_cc.path],
+            mnemonic = "V8NativeWindowsInlineAssembly",
+        )
+        outs = [outs[0], embedded_cc]
     return [DefaultInfo(files = depset(outs))]

