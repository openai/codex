# A Linux Codex release archive carries Chromium's namespaced libc++ runtime.
# Bazel also links its own libc++. Both keep their exception classes in std::,
# so prefer the toolchain definitions of just those shared ABI entry points.
# Inputs remain checksum-verified and immutable; only the Bazel output changes.
[
    genrule(
        name = "v8_152_2_0_%s_unknown_linux_%s_prebuilt" % (arch, libc),
        srcs = [
            ":gnu_libcxx_shared_exception_symbols.txt",
            "@rusty_v8_152_2_0_%s_unknown_linux_%s_archive//file" % (arch, libc),
        ],
        outs = ["libv8_152_2_0_%s_unknown_linux_%s_prebuilt.a" % (arch, libc)],
        cmd = """
            gzip -dc "$(location @rusty_v8_152_2_0_%s_unknown_linux_%s_archive//file)" > "$@.unadjusted"
            $(location @llvm//tools:llvm-objcopy) \
                --weaken-symbols="$(location :gnu_libcxx_shared_exception_symbols.txt)" \
                "$@.unadjusted" "$@"
            rm "$@.unadjusted"
        """ % (arch, libc),
        tools = ["@llvm//tools:llvm-objcopy"],
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
    for libc in [
        "gnu",
        "musl",
    ]
]

