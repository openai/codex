# Compile the pinned Chromium libc++ into V8 with the Microsoft CRT.
cc_static_library(
    name = "v8_152_2_0_native_windows_objects",
    features = V8_STATIC_LIBRARY_FEATURES,
    tags = ["manual"],
    target_compatible_with = select({
        ":platform_windows_msvc": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":rusty_v8_custom_libcxx_runtime",
        ":v8_152_2_0_binding",
    ],
)

# cc_static_library only collects object files, not prebuilt libraries.
# The Rust build script receives one .lib without Bazel's CcInfo/linkdeps, so
# merge compiler-rt into the staged artifact explicitly.
genrule(
    name = "v8_152_2_0_native_windows_library",
    srcs = [
        ":v8_152_2_0_native_windows_objects",
        "@v8_native_windows_llvm//:builtins_archive",
    ],
    outs = ["rusty_v8_native_windows.lib"],
    cmd_bat = '""$(location @v8_native_windows_llvm//:llvm-lib)" /NOLOGO /OUT:"$@" "$(location :v8_152_2_0_native_windows_objects)" "$(location @v8_native_windows_llvm//:builtins_archive)""',
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
    tools = ["@v8_native_windows_llvm//:llvm-lib"],
)

[
    v8_artifact_files(
        name = "v8_152_2_0_%s_pc_windows_msvc_bazel" % arch,
        srcs = [":v8_152_2_0_native_windows_library"],
        profile = "sandbox_release",
        tags = ["manual"],
        target_compatible_with = [
            "@platforms//cpu:%s" % arch,
            "@platforms//os:windows",
            "@llvm//constraints/windows/abi:msvc",
        ],
        v8_cpu = cpu,
    )
    for arch, cpu in [
        ("x86_64", "x64"),
        ("aarch64", "arm64"),
    ]
]

