# Local source producers match the Rust consumer's sandbox ABI, and use the
# workspace C++ runtime. Release pairs below select pinned Chromium libc++ and
# build the private source nodes directly under their own profiles.
[
    v8_artifact_files(
        name = name,
        srcs = [":_" + name],
        profile = "source",
        v8_cpu = cpu,
    )
    for name, cpu in [
        ("v8_152_2_0_aarch64_apple_darwin_bazel", "arm64"),
        ("v8_152_2_0_aarch64_unknown_linux_gnu_bazel", "arm64"),
        ("v8_152_2_0_aarch64_pc_windows_gnullvm_bazel", "arm64"),
        ("v8_152_2_0_aarch64_unknown_linux_musl_release", "arm64"),
        ("v8_152_2_0_x86_64_apple_darwin_bazel", "x64"),
        ("v8_152_2_0_x86_64_unknown_linux_gnu_bazel", "x64"),
        ("v8_152_2_0_x86_64_pc_windows_gnullvm_bazel", "x64"),
        ("v8_152_2_0_x86_64_unknown_linux_musl_release", "x64"),
    ]
]

