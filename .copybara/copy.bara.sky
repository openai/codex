# Keep the internal-to-public filtering below synchronized with Copyberry's
# codex-internal-no-internal-code/push/copy.bara.sky configuration.
INTERNAL_ONLY_FILES = [
    ".copybara/**",
    ".github/internal/**",
    ".github/workflows/copybara-*.yml",
    "codex-rs/internal*/**",
]

# The internal workspace lockfile contains internal package names. Preserve a
# sanitized destination lockfile and reconcile it after creating the public
# projection.
PRESERVED_DESTINATION_FILES = [
    "codex-rs/Cargo.lock",
]

# Keep synchronized with VERBATIM_PUBLIC_FILES in Copyberry's
# codex-internal-to-codex-oss/push/copy.bara.sky configuration. These paths
# retain their repository-root locations; every other public path belongs
# below public/ in codex-internal.
VERBATIM_PUBLIC_FILES = [
    "LICENSE",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "codex-cli/**",
    "codex-rs/**",
    "sdk/**",
    "third_party/**",
]

PUBLIC_TO_INTERNAL_ORIGIN_FILES = glob(["**"])

PUBLIC_TO_INTERNAL_STAGING_DIRECTORY = ".copybara-public-import-staging"

PUBLIC_TO_INTERNAL_PREFIXED_FILES = glob(
    ["**"],
    exclude = VERBATIM_PUBLIC_FILES + [
        "public/**",
        PUBLIC_TO_INTERNAL_STAGING_DIRECTORY + "/**",
    ],
)

PUBLIC_TO_INTERNAL_DESTINATION_FILES = glob(
    VERBATIM_PUBLIC_FILES + ["public/**"],
    exclude = ["codex-rs/internal*/**"],
)

PUBLIC_FILES = glob(
    ["**"],
    exclude = INTERNAL_ONLY_FILES + PRESERVED_DESTINATION_FILES,
)

INTERNAL_ONLY_MARKER_FILES = glob(
    [
        "codex-rs/Cargo.toml",
        "codex-rs/**/Cargo.toml",
        "codex-rs/**/*.rs",
    ],
    exclude = INTERNAL_ONLY_FILES,
)

PROJECT_INTERNAL_ONLY_MARKERS_TO_PUBLIC = core.transform(
    [
        core.replace(
            before = "${internal}${public}${end}",
            after = "${public}",
            multiline = True,
            regex_groups = {
                "internal": "(?m)^.*copybara:replace-for-public begin.*\\n[\\w\\W]*?^.*copybara:replace-for-public with.*\\n",
                "public": "(?m)(?:^[ \\t]*(?:#|//)[ \\t]*copybara:public(?:[ \\t].*)?\\n?)+",
                "end": "(?m)^.*copybara:replace-for-public end.*\\n?",
            },
            paths = INTERNAL_ONLY_MARKER_FILES,
        ),
        core.replace(
            before = "${indent}${comment}${space}copybara:public${separator}${line}",
            after = "${indent}${line}",
            regex_groups = {
                "indent": "[ \\t]*",
                "comment": "(?:#|//)",
                "space": "[ \\t]*",
                "separator": "[ \\t]?",
                "line": ".*",
            },
            paths = INTERNAL_ONLY_MARKER_FILES,
        ),
        core.replace(
            before = "${block}",
            after = "",
            multiline = True,
            regex_groups = {
                "block": "(?m)^.*copybara:strip-for-public begin.*\\n[\\w\\W]*?^.*copybara:strip-for-public end.*\\n?",
            },
            paths = INTERNAL_ONLY_MARKER_FILES,
        ),
        core.replace(
            before = "${line}",
            after = "",
            multiline = True,
            regex_groups = {
                "line": "(?m)^.*copybara:strip-for-public.*\\n?",
            },
            paths = INTERNAL_ONLY_MARKER_FILES,
        ),
        core.verify_match(
            "copybara:",
            paths = INTERNAL_ONLY_MARKER_FILES,
            verify_no_match = True,
            failure_message = "Malformed copybara marker remained after internal-to-public transforms.",
        ),
    ],
    reversal = [],
    noop_behavior = "IGNORE_NOOP",
)

SYNC_AUTHOR = "OpenAI Codex Sync <codex-sync@openai.com>"

def optional_move(before, after):
    return core.transform(
        transformations = [
            core.move(
                before = before,
                after = after,
            ),
        ],
        reversal = [],
        noop_behavior = "IGNORE_NOOP",
    )

def public_to_internal_transformations():
    return [
        # Moving the root into public/ cannot move an existing public/ directory
        # into itself, so stage that directory before prefixing the other paths.
        optional_move(
            before = "public",
            after = PUBLIC_TO_INTERNAL_STAGING_DIRECTORY,
        ),
        core.move(
            before = "",
            after = "public",
            paths = PUBLIC_TO_INTERNAL_PREFIXED_FILES,
        ),
        optional_move(
            before = PUBLIC_TO_INTERNAL_STAGING_DIRECTORY,
            after = "public/public",
        ),
    ]

core.workflow(
    name = "public_to_internal",
    origin = git.origin(
        url = "https://github.com/openai/codex.git",
        ref = "main",
    ),
    destination = git.destination(
        url = "https://github.com/openai/codex-internal.git",
        fetch = "main",
        push = "copybara/public-to-internal",
    ),
    origin_files = PUBLIC_TO_INTERNAL_ORIGIN_FILES,
    # Stage the public Cargo.lock so the Actions wrapper can either retain it
    # or restore the internal lockfile before reconciling the workspace.
    destination_files = PUBLIC_TO_INTERNAL_DESTINATION_FILES,
    authoring = authoring.pass_thru(SYNC_AUTHOR),
    mode = "SQUASH",
    custom_rev_id = "Codex-Public-RevId",
    merge_import = core.merge_import_config(
        package_path = "",
        paths = INTERNAL_ONLY_MARKER_FILES,
    ),
    transformations = public_to_internal_transformations(),
)

# Local projection used by verify_copybara_config.py to ensure the fallback
# import remains the inverse of Copyberry's public/ flattening behavior.
core.workflow(
    name = "public_to_internal_projection",
    origin = folder.origin(),
    destination = folder.destination(),
    origin_files = PUBLIC_TO_INTERNAL_ORIGIN_FILES,
    destination_files = PUBLIC_TO_INTERNAL_DESTINATION_FILES,
    authoring = authoring.pass_thru(SYNC_AUTHOR),
    mode = "SQUASH",
    transformations = public_to_internal_transformations(),
)

core.workflow(
    name = "internal_to_public_branch",
    origin = git.origin(
        url = "https://github.com/openai/codex-internal.git",
        ref = "main",
    ),
    destination = git.destination(
        url = "https://github.com/openai/codex.git",
        fetch = "main",
        push = "copybara/internal-to-public",
    ),
    origin_files = PUBLIC_FILES,
    destination_files = PUBLIC_FILES,
    authoring = authoring.pass_thru(SYNC_AUTHOR),
    mode = "SQUASH",
    transformations = [PROJECT_INTERNAL_ONLY_MARKERS_TO_PUBLIC],
)

core.workflow(
    name = "internal_to_public_projection",
    origin = folder.origin(),
    destination = folder.destination(),
    origin_files = PUBLIC_FILES,
    destination_files = glob(
        ["**"],
        exclude = PRESERVED_DESTINATION_FILES,
    ),
    authoring = authoring.pass_thru(SYNC_AUTHOR),
    mode = "SQUASH",
    transformations = [PROJECT_INTERNAL_ONLY_MARKERS_TO_PUBLIC],
)
